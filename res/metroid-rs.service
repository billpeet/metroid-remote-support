[Unit]
Description=Metroid Remote Support
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/metroid-rs --service
# kill --tray and --server both
ExecStop=pkill -f "metroid-rs --"
PIDFile=/run/metroid-rs.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
